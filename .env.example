# Copy to .env.local for development, and add the same two values in Vercel > Settings > Environment Variables.
# Supabase dashboard > Project Settings > API Keys (use the "Publishable" key, NOT the secret/service-role key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# The app needs no secret keys. The GitHub Actions (keep-alive + backup, next steps) use repo secrets, not this file.
