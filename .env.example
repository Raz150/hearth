# Copy to .env.local for development, and add the same values in Vercel > Settings > Environment Variables.

# Supabase dashboard > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# ── Push notifications (server only, except the public VAPID key) ──
# The SECRET key (sb_secret_...) bypasses RLS. Only the push routes use it. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_your_key
# Generate once: npx web-push generate-vapid-keys. Changing them later means both phones must turn notifications on again.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
# Random strings (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"). PUSH_WEBHOOK_SECRET must match the 'push_secret' in Supabase Vault.
PUSH_WEBHOOK_SECRET=long_random_string
# Vercel Cron sends this as "Authorization: Bearer ..." to /api/push/digest.
CRON_SECRET=another_long_random_string

# The GitHub Actions (keep-alive + backup) use repo secrets, not this file.
