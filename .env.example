# Copy to .env.local for development and add the same values in Vercel.
# Supabase dashboard: Project Settings > Data API / API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server only, used by /api/send-email. Set these in Vercel.
# Supabase dashboard: Authentication > Hooks > Send Email (generates the secret).
SEND_EMAIL_HOOK_SECRET=v1,whsec_your_secret
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your16characterapppassword
